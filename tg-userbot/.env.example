# Salin ke .env di VPS (chmod 600). Isi nilai manual; JANGAN commit .env.
TG_API_ID=
TG_API_HASH=
# Path file berisi StringSession (hasil scripts/login.mjs), chmod 600
TG_SESSION_FILE=/home/ec2-user/axvara-tg-userbot/session.string
# Supergroup staging (sumber) dan channel publik (tujuan), format -100...
TG_ALLOW_FROM_CHAT=
TG_ALLOW_TO_CHAT=
TG_STATE_FILE=/home/ec2-user/axvara-tg-userbot/state.json
TG_USERBOT_PORT=8791
