diff --git a/test/session-refresh.test.mjs b/test/session-refresh.test.mjs
new file mode 100644
--- /dev/null
+++ b/test/session-refresh.test.mjs
@@ -0,0 +1,47 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { GopayProvider } from 'merchantid';
+import { readonlyGoBizFetch } from '../dist/gobiz-transport.js';
+
+for (const expired of [false, true]) {
+ test(`SDK expiry check ${expired ? 'refreshes and persists before feed' : 'makes no refresh request for a valid session'}`, async () => {
+  const calls = [];
+  let persisted = false;
+  const p = new GopayProvider({
+   merchantId: 'fixture', session: {deviceId: 'fixture', tokens: {accessToken: 'old', refreshToken: 'refresh', expiresAt: expired ? 1 : Date.now()+3600000}},
+   onTokenRefreshed: session => {assert.equal(session.tokens.accessToken, 'new'); persisted=true;},
+   fetch: readonlyGoBizFetch(async (input, init) => {
+    const path = new URL(input).pathname;
+    calls.push(path);
+    if(path === '/goid/token') return Response.json({access_token:'new',refresh_token:'rotated',expires_in:1800},{status:201});
+    assert.equal(persisted, expired);
+    assert.equal(init.headers.Authorization, `Bearer ${expired ? 'new' : 'old'}`);
+    return Response.json({transactions:[]});
+   }),
+  });
+  await p.refreshSession();
+  await p.transactions.list('fixture',{startTime:new Date(Date.now()-60000),endTime:new Date()});
+  assert.deepEqual(calls, [...(expired ? ['/goid/token'] : []), '/merchant-analytics/v2/merchants/transactions']);
+ });
+}
+
+test('expiry refresh failure stops before feed, without retrying refresh', async () => {
+ const calls=[];
+ const p=new GopayProvider({
+  merchantId:'fixture',session:{deviceId:'fixture',tokens:{accessToken:'old',refreshToken:'refresh',expiresAt:1}},
+  fetch:readonlyGoBizFetch(async input=>{calls.push(new URL(input).pathname);return Response.json({},{status:429});}),
+ });
+ await assert.rejects(async()=>{await p.refreshSession();await p.transactions.list('fixture',{startTime:new Date(),endTime:new Date()});});
+ assert.deepEqual(calls,['/goid/token']);
+});
+
+test('session persistence failure stops before feed', async () => {
+ const calls=[];
+ const p=new GopayProvider({
+  merchantId:'fixture',session:{deviceId:'fixture',tokens:{accessToken:'old',refreshToken:'refresh',expiresAt:1}},
+  onTokenRefreshed:()=>{throw new Error('session_persist_failed');},
+  fetch:readonlyGoBizFetch(async input=>{calls.push(new URL(input).pathname);return Response.json({access_token:'new',expires_in:1800},{status:201});}),
+ });
+ await assert.rejects(async()=>{await p.refreshSession();await p.transactions.list('fixture',{startTime:new Date(),endTime:new Date()});},/session_persist_failed/);
+ assert.deepEqual(calls,['/goid/token']);
+});
