+import { join } from "node:path";
+import { createDiffSync } from "../dist/diff-sync.js";
+
+const dir = mkdtempSync(join(tmpdir(), "axvara-wrsk-removal-"));
+const logger = { info() {}, warn() {}, error() {} };
+try {
+  // Skenario PM: induk WR berubah + 300 varian hilang (<50% dari ~700),
+  // ack 200 pertama, gagal di 100 berikut, restart → hanya sisa 100,
+  // siklus berikut TANPA duplikat removal.
+  const file = join(dir, "wr.json");
+  // ~700 varian awal: 40 induk x ~17 varian + induk target P0 (301 varian).
+  const mkCatalog = (mutate) => {
+    const products = [];
+    for (let p = 1; p <= 40; p++) {
+      products.push({ id: `p${p}`, variants: Array.from({ length: 10 }, (_, i) => ({ id: `v${p}_${i}` })) });
+    }
+    products.push({ id: "P0", variants: Array.from({ length: 301 }, (_, i) => ({ id: `w${i}` })) });
+    if (mutate) {
+      // P0 berubah (stok) + kehilangan w0..w299 (300 hilang, sisa w300).
+      const p0 = products.find((p) => p.id === "P0");
+      p0.variants = [{ id: "w300", stock: 0 }];
+      // Satu induk hilang total (10 varian) agar pendingRemovedKeys ikut diuji.
+      return products.filter((p) => p.id !== "p40");
+    }
+    return products;
+  };
+  let rows = [];
+  for (let i = 0; i < 400; i++) rows.push({ variant: { id: 10_000 + i } });
+  let failAt = -1;
+  const sent = [];
+  let t = 5e9;
+  let catalog = mkCatalog(false);
+  const mk = () => createDiffSync({
+    origin: "https://receiver.test", token: "fixture", stateFile: file,
+    fetchWr: async () => catalog,
+    fetchSk: async () => rows,
+    logger, fetchFn: async (url, init) => {
+      const b = JSON.parse(init.body);
+      if (b.supplier === "wr") {
+        assert.ok((b.removed_variant_ids || []).length <= 200, "removal slice >200");
+        sent.push(b);
+        if (b.removed_variant_ids.length && sent.filter((x) => x.supplier === "wr").length === failAt) {
+          return new Response("{}", { status: 503 });
+        }
+      }
+      return new Response("{}", { status: 200 });
+    },
+    now: () => t, wrChunkMax: 8, skChunkMax: 50,
+  });
+
+  // Siklus 1: baseline penuh (ack semua).
+  let d = mk();
+  await d.cycle();
+  sent.length = 0;
+
+  // Siklus 2: P0 berubah + 310 hilang (300 parsial + 10 induk hilang) <50%.
+  catalog = mkCatalog(true);
+  failAt = 2; // batch ke-2 (sisa 110: 100 P0 + 10 p40... lihat di bawah)
+  await d.cycle();
+  const wrBatches = sent.filter((b) => b.supplier === "wr");
+  assert.ok(wrBatches.length >= 2, `expected >=2 wr batches, got ${wrBatches.length}`);
+  assert.ok(wrBatches.every((b) => (b.removed_variant_ids || []).length <= 200));
+  // Batch pertama membawa 200 ID hilang; batch kedua GAGAL (503).
+  assert.equal(wrBatches[0].removed_variant_ids.length, 200);
+  // Payload P0 yang berubah HARUS sudah terkirim di salah satu batch (no-loss
+  // walau batch payload lebih lambat dari batch removal).
+  const p0Sent = wrBatches.some((b) => (b.products || []).some((p) => p.id === "P0"));
+  assert.ok(p0Sent, "changed parent P0 payload must be sent (no-loss)");
+
+  // Restart setelah partial apply: hanya sisa yang belum ter-ack.
+  d = mk();
+  sent.length = 0; failAt = -1;
+  await d.cycle();
+  const replay = sent.filter((b) => b.supplier === "wr");
+  const replayRemoved = replay.flatMap((b) => b.removed_variant_ids || []);
+  assert.equal(replayRemoved.length, 110, `expected 110 remaining, got ${replayRemoved.length}`);
+  assert.ok(replay.every((b) => (b.removed_variant_ids || []).length <= 200));
+  // Tidak ada ID yang sudah ter-ack ikut terkirim ulang.
+  const first200 = new Set(wrBatches[0].removed_variant_ids);
+  assert.ok(replayRemoved.every((id) => !first200.has(id)), "acked IDs must not replay");
+
+  // Siklus berikut TANPA perubahan: tidak ada duplikat removal.
+  sent.length = 0; t += 60e3;
+  await d.cycle();
+  assert.equal(sent.filter((b) => b.supplier === "wr").length, 0, "no duplicate removal resend");
+
+  // Removal ACK can precede its parent's changed payload by many batches.
+  // A restart must preserve that payload's old hash so it still gets sent.
+  const lateFile = join(dir, "late-parent.json");
+  let lateCatalog = [
+    ...Array.from({ length: 20 }, (_, p) => ({ id: `keep${p}`, variants: Array.from({ length: 30 }, (_, i) => ({ id: `keep${p}_${i}` })) })),
+    { id: "late", variants: Array.from({ length: 301 }, (_, i) => ({ id: `lost${i}` })) },
+  ];
+  let lateFail = false;
+  const lateSent = [];
+  const mkLate = () => createDiffSync({
+    origin: "https://receiver.test", token: "fixture", stateFile: lateFile,
+    fetchWr: async () => lateCatalog, fetchSk: async () => [{ variant: { id: 1 } }],
+    wrChunkMax: 1, now: () => t, logger,
+    fetchFn: async (_url, init) => {
+      const b = JSON.parse(init.body);
+      if (b.supplier === "wr") {
+        lateSent.push(b);
+        if (lateFail && lateSent.length === 2) return new Response("{}", { status: 503 });
+      }
+      return new Response("{}", { status: 200 });
+    },
+  });
+  let late = mkLate(); await late.cycle(); lateSent.length = 0;
+  lateCatalog = lateCatalog.map(p => ({ ...p, title: "changed", ...(p.id === "late" ? { variants: [{ id: "lost300" }] } : {}) }));
+  lateFail = true; await late.cycle();
+  const acceptedIds = new Set(lateSent[0].removed_variant_ids);
+  assert.equal(acceptedIds.size, 200);
+  assert.ok(!lateSent.some(b => b.products.some(p => p.id === "late")));
+  late = mkLate(); lateFail = false; lateSent.length = 0; await late.cycle();
+  assert.equal(lateSent.flatMap(b => b.removed_variant_ids).length, 100);
+  assert.ok(lateSent.flatMap(b => b.removed_variant_ids).every(id => !acceptedIds.has(id)));
+  assert.ok(lateSent.some(b => b.products.some(p => p.id === "late" && p.title === "changed")));
+  lateSent.length = 0; t += 60e3; await mkLate().cycle();
+  assert.equal(lateSent.length, 0);
+
+  // SK removals juga dipotong ≤200 dan ack-only.
+  const skFile = join(dir, "sk.json");
+  let skRows = Array.from({ length: 500 }, (_, i) => ({ variant: { id: 1 + i } }));
+  const skSent = [];
+  let skFail = false;
+  const mkSk = () => createDiffSync({
+    origin: "https://receiver.test", token: "fixture", stateFile: skFile,
+    fetchWr: async () => [{ id: "keep", variants: [{ id: "k1" }] }],
+    fetchSk: async () => skRows,
+    logger, fetchFn: async (url, init) => {
+      const b = JSON.parse(init.body);
+      if (b.supplier === "sk" && !b.action) {
+        assert.ok((b.removed_variant_ids || []).length <= 200);
+        skSent.push(b);
+        if (skFail && skSent.length === 1) return new Response("{}", { status: 503 });
+      }
+      return new Response("{}", { status: 200 });
+    },
+    now: () => t, wrChunkMax: 8, skChunkMax: 20,
+  });
+  let skd = mkSk();
+  await skd.cycle();
+  skSent.length = 0;
+  skRows = skRows.slice(210); // 210 hilang (<50% dari 500) → 1 slice 200 + 1 slice 10
+  skFail = true;
+  await skd.cycle();
+  assert.deepEqual(skSent.filter((b) => !b.action).map((b) => (b.removed_variant_ids || []).length), [200]);
+  skd = mkSk(); skSent.length = 0; skFail = false;
+  await skd.cycle();
+  // Slice pertama GAGAL → tidak ada yang di-ack → replay penuh 200 + 10.
+  assert.deepEqual(skSent.filter((b) => !b.action).map((b) => (b.removed_variant_ids || []).length), [200, 10]);
+  skSent.length = 0; t += 60e3;
+  await mkSk().cycle();
+  assert.equal(skSent.length, 0, "no SK duplicate removal resend");
+
+  console.log("DIFF_REMOVAL_OK");
+} finally {
+  rmSync(dir, { recursive: true, force: true });
+}
