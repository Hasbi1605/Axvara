+const match={amount:10137,orderCode:'fixture',txId:'stable-id',merchantId:'G111111111',paidAt:'2026-10-27T00:00:00Z',status:'settlement'};
+
+test('only durable JSON ACKs acknowledge a payment, preserving the stable event ID',async()=>{
+ for(const status of ['paid','already_paid','duplicate','unmatched']){
+  const ok=await forwardPayment('http://fixture','test-secret',match,async(url,options)=>{
+   assert.equal(options.redirect,'manual');assert.ok(options.signal);
+   assert.equal(JSON.parse(options.body).event_id,'gopay-poller:stable-id');
+   assert.equal(options.headers['x-poller-signature'],createHmac('sha256','test-secret').update(options.body).digest('hex'));
+   assert.equal(JSON.parse(options.body).merchant_id,match.merchantId);
+   assert.equal(JSON.parse(options.body).paid_at,match.paidAt);
+   assert.equal(JSON.parse(options.body).transaction_status,'settlement');
+   return Response.json({ok:true,status});
+  });
+  assert.equal(ok,true,status);
+ }
+});
+test('4xx, redirects, 5xx and malformed or unknown success receipts never suppress retry',async()=>{
+ for(const code of [301,302,400,401,403,408,409,413,415,429,500,503]){
+  assert.equal(await forwardPayment('http://fixture','secret',match,async()=>Response.json({ok:true,status:'paid'},{status:code})),false,String(code));
+ }
+ for(const body of ['{}','null','<html>oops</html>','{"ok":true,"status":"processing"}','{"ok":false,"status":"paid"}']){
+  assert.equal(await forwardPayment('http://fixture','secret',match,async()=>new Response(body)),false,body);
+ }
+ assert.equal(await forwardPayment('http://fixture','secret',match,async()=>{throw new Error('network');}),false);
+ assert.equal(await forwardPayment('http://fixture','secret',match,async()=>({ok:true,json:async()=>{throw new Error('body reset');}})),false);
