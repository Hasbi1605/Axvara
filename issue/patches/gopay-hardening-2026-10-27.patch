+import {feedInterval,liveInvoices,matchSettlements,transactionTime,errorKind} from '../dist/poll-safety.js';
+import {loadFeedState,sessionDigest,writePrivateJson} from '../dist/durable-store.js';
+const now=Date.parse('2026-10-27T00:10:00Z'),merchant='G111111111';
+const invoice={order_code:'fixture',payable_amount:10137,issued_at:'2026-10-27 00:09:00',expires_at:'2026-10-27T00:24:00Z'};
+const tx={id:'tx',merchantId:merchant,currency:'IDR',grossAmount:10137,status:'settlement',transactionTime:'2026-10-27T00:09:20Z',paymentType:'qris'};
+
+test('matches only settled IDR payments for the stored merchant inside the invoice lifetime',()=>{
+ assert.equal(matchSettlements(merchant,[invoice],[tx],now).length,1);
+ for(const invalid of [{status:''},{status:'pending'},{currency:'USD'},{merchantId:'G222222222'},
+  {transactionTime:'invalid'},{transactionTime:'2026-10-27T00:09:20'},
+  {transactionTime:'2026-10-27T00:01:00Z'},{transactionTime:'2026-10-27T00:25:00Z'},
+  {paymentType:'withdrawal'},{grossAmount:10136}]){
+  assert.equal(matchSettlements(merchant,[invoice],[{...tx,...invalid}],now).length,0,JSON.stringify(invalid));
+ }
+ assert.equal(matchSettlements(merchant,[invoice],[tx,{...tx,id:'second'}],now).length,0);
+ assert.equal(transactionTime('2026-10-27 07:09:20'),Date.parse(tx.transactionTime));
+});
+test('stale or malformed invoices cannot trigger a merchant query',()=>{
+ assert.deepEqual(liveInvoices([{...invoice,expires_at:'2026-10-27T00:00:00Z'},{...invoice,issued_at:''},
+  {...invoice,payable_amount:-1},{...invoice,issued_at:'2099-01-01T00:00:00Z'}],now),[]);
+});
+test('feed cadence slows by invoice age and a new pending invoice restores the minimum cadence',()=>{
+ assert.equal(feedInterval([invoice],15000,now),15000);
+ const older={...invoice,issued_at:'2026-10-27T00:07:00Z'};
+ assert.equal(feedInterval([older],15000,now),30000);
+ assert.equal(feedInterval([{...older,issued_at:'2026-10-27T00:04:00Z'}],15000,now),60000);
+ assert.equal(feedInterval([older,invoice],15000,now),15000);
+ assert.equal(feedInterval([invoice],45000,now),45000);
+});
+test('restart preserves rate limits and restrictions; only a changed session clears the manual hold',()=>{
+ const dir=mkdtempSync(join(tmpdir(),'axvara-gopay-state-'));
+ try{
+  const path=join(dir,'session');writePrivateJson(path,{tokens:'fixture-session'});
+  const state={sessionDigest:sessionDigest(path),nextPollAt:now+15000,backoffUntil:now+600000,feedErrorStreak:2,last401NotifyAt:now,blockedReason:'account_restricted_manual_review'};
+  writePrivateJson(path+'.poll-state',state);
+  assert.deepEqual(loadFeedState(path),state);
+  assert.equal(statSync(path).mode&0o777,0o600);assert.equal(statSync(path+'.poll-state').mode&0o777,0o600);
+  assert.equal(readFileSync(path+'.poll-state','utf8').includes('fixture-session'),false);
+  writePrivateJson(path,{tokens:'manual-new-session'});
+  assert.equal(loadFeedState(path).blockedReason,null);assert.equal(loadFeedState(path).backoffUntil,0);
+  assert.equal(loadFeedState(path).nextPollAt,state.nextPollAt);
+  writeFileSync(path+'.poll-state','{corrupt');assert.throws(()=>loadFeedState(path));
+ }finally{rmSync(dir,{recursive:true,force:true});}
+});
+test('failed session persistence throws instead of acknowledging a rotated token',()=>{
+ assert.throws(()=>writePrivateJson('/directory-that-does-not-exist/session',{tokens:'private'}));
+ assert.equal(errorKind({code:'SESSION_PERSIST_FAILED'}),'persistence');
+ assert.equal(errorKind({message:'Refresh token expired. Please login again.'}),'session');
+ assert.equal(errorKind({status:401}),'auth');assert.equal(errorKind({status:403}),'restricted');assert.equal(errorKind({status:429}),'rate_limit');
+});
