+++ b/src/merchant-routing.ts
@@ -0,0 +1,32 @@
+export type PendingInvoice = {
+  order_code: string;
+  payable_amount: number;
+  expires_at: string;
+  issued_at: string;
+  merchant_id?: string | null;
+};
+
+/** Sesi terpisah: token yang berotasi tidak boleh menimpa akun merchant lain. */
+export function merchantSessionPaths(primaryId: string, primaryPath: string, secondaryId?: string, secondaryPath?: string): Map<string, string> {
+  if (!/^G\d{9}$/.test(primaryId) || !primaryPath) throw new Error("invalid_primary_merchant_session");
+  const sessions = new Map([[primaryId, primaryPath]]);
+  if (!secondaryId && !secondaryPath) return sessions;
+  if (!secondaryId || !secondaryPath || !/^G\d{9}$/.test(secondaryId)
+    || secondaryId === primaryId || secondaryPath === primaryPath) throw new Error("invalid_secondary_merchant_session");
+  sessions.set(secondaryId, secondaryPath);
+  return sessions;
+}
+
+/** Hanya respons Pages lama tanpa field yang memakai merchant legacy. */
+export function routePendingInvoices(pending: PendingInvoice[], legacyMerchantId: string, sessions: ReadonlyMap<string, string>) {
+  const byMerchant = new Map<string, PendingInvoice[]>();
+  let unroutable = 0;
+  for (const invoice of pending) {
+    const merchantId = invoice.merchant_id === undefined ? legacyMerchantId : invoice.merchant_id;
+    if (typeof merchantId !== "string" || !sessions.has(merchantId)) { unroutable++; continue; }
+    const group = byMerchant.get(merchantId) ?? [];
+    group.push(invoice);
+    byMerchant.set(merchantId, group);
+  }
+  return { byMerchant, unroutable };
+}
