+import {appendFileSync} from 'node:fs';
+const fixture=JSON.parse(process.env.POLLER_TEST_FEEDS);
+export class GopayProvider {
+ constructor(config) {
+  this.config=config;
+  if(config.session.account!==config.merchantId) throw new Error('wrong_account_session');
+  this.transactions={list:async merchantId=>{
+   if(merchantId!==config.merchantId) throw new Error('wrong_merchant_feed');
+   appendFileSync(process.env.POLLER_TEST_CALLS,JSON.stringify({merchantId,at:Date.now()})+'\n');
+   const feed=fixture[merchantId];
+   if(feed.error) throw new Error(feed.error);
+   if(feed.failPersist){
+    try{config.onTokenRefreshed({tokens:1n});}catch{throw Object.assign(new Error('401 unauthorized'),{status:401});}
+   }
+   config.onTokenRefreshed({account:merchantId,refreshed:true});
+   return feed.transactions.map(t=>({merchantId,currency:'IDR',...t}));
+  }};
+ }
+}
