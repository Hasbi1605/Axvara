@@ -0,0 +1,32 @@
+const ACK_STATUSES = new Set(["paid", "already_paid", "duplicate", "unmatched"]);
+
+/** Only a durable Pages decision may suppress this mutation on later ticks. */
+export async function forwardPayment(
+  pagesBase: string,
+  secret: string,
+  match: { amount: number; orderCode: string; txId: string; merchantId: string; paidAt: string; status: string },
+  request: typeof fetch = fetch,
+): Promise<boolean> {
+  try {
+    const body = JSON.stringify({
+      amount: match.amount, order_code: match.orderCode,
+      event_id: `gopay-poller:${match.txId}`, payment: { id: match.txId },
+      merchant_id: match.merchantId, paid_at: match.paidAt, currency: "IDR", transaction_status: match.status,
+    });
+    const res = await request(`${pagesBase}/api/webhook/gopay`, {
+      method: "POST",
+      redirect: "manual",
+      headers: { "content-type": "application/json", "x-poller-secret": secret,
+        "x-poller-signature": createHmac("sha256", secret).update(body).digest("hex") },
+      body,
+      signal: AbortSignal.timeout(15_000),
+    });
+    if (!res.ok) return false;
+    const ack = await res.json() as { ok?: unknown; status?: unknown } | null;
+    return ack?.ok === true && typeof ack.status === "string" && ACK_STATUSES.has(ack.status);
+  } catch {
+    return false;
+  }
+}
+import { createHmac } from "node:crypto";
+
diff --git a/src/poll-safety.ts b/src/poll-safety.ts
new file mode 100644
--- /dev/null
+++ b/src/poll-safety.ts
@@ -0,0 +1,62 @@
+import type { PendingInvoice } from "./merchant-routing.js";
+
+export const SETTLED = new Set(["settlement", "capture"]);
+export const CLOCK_SKEW_MS = 60_000;
+export type GoBizTx = {
+  id: string; merchantId: string; grossAmount: number; realGrossAmount?: number;
+  status: string; currency: string; transactionTime: string; paymentType: string;
+};
+
+export function invoiceTime(value: string): number {
+  return Date.parse(/^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d$/.test(value) ? value.replace(" ", "T") + "Z" : value);
+}
+
+export function transactionTime(value: string): number {
+  if (/^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d$/.test(value)) return Date.parse(value.replace(" ", "T") + "+07:00");
+  return /(?:Z|[+-]\d{2}:\d{2})$/.test(value) ? Date.parse(value) : NaN;
+}
+
+export function liveInvoices(pending: PendingInvoice[], now = Date.now()): PendingInvoice[] {
+  return pending.filter(p => typeof p.order_code === "string" && p.order_code.length > 0
+    && Number.isSafeInteger(p.payable_amount) && p.payable_amount > 0
+    && Number.isFinite(invoiceTime(p.issued_at)) && invoiceTime(p.issued_at) <= now + CLOCK_SKEW_MS
+    && Number.isFinite(invoiceTime(p.expires_at)) && invoiceTime(p.expires_at) > now
+    && invoiceTime(p.expires_at) > invoiceTime(p.issued_at));
+}
+
+export function feedInterval(pending: PendingInvoice[], minimum: number, now = Date.now()): number {
+  const newest = Math.max(...pending.map(p => invoiceTime(p.issued_at)));
+  const age = now - newest;
+  return Math.max(minimum, age < 120_000 ? 15_000 : age < 300_000 ? 30_000 : 60_000);
+}
+
+export function matchSettlements(merchantId: string, pending: PendingInvoice[], mutations: GoBizTx[], now = Date.now()) {
+  const used = new Set<string>();
+  const matches: { pen: PendingInvoice; tx: GoBizTx }[] = [];
+  for (const pen of liveInvoices(pending, now)) {
+    const issued = invoiceTime(pen.issued_at), expires = invoiceTime(pen.expires_at);
+    const candidates = mutations.filter(tx => {
+      const paid = transactionTime(tx.transactionTime);
+      return tx.id && !used.has(tx.id) && tx.merchantId === merchantId && tx.currency === "IDR"
+        && SETTLED.has(tx.status.trim().toLowerCase()) && ["qris", "gopay"].includes(tx.paymentType.toLowerCase())
+        && (tx.grossAmount === pen.payable_amount || tx.realGrossAmount === pen.payable_amount)
+        && Number.isFinite(paid) && paid >= issued - CLOCK_SKEW_MS && paid <= expires && paid <= now + CLOCK_SKEW_MS;
+    });
+    // Multiple matching payments need manual review; choosing one silently can
+    // consume an unrelated transfer with the same amount.
+    if (candidates.length !== 1) continue;
+    const tx = candidates[0]; used.add(tx.id); matches.push({ pen, tx });
+  }
+  return matches;
+}
+
+export function errorKind(error: unknown): "session" | "persistence" | "auth" | "restricted" | "rate_limit" | "feed" {
+  const value = error as { message?: string; status?: number; code?: string };
+  const message = String(value?.message ?? "");
+  if (value?.code === "SESSION_PERSIST_FAILED") return "persistence";
+  if (/refresh token|login again|invalid_grant/i.test(message)) return "session";
+  if (value?.status === 401 || /401|unauthorized/i.test(message)) return "auth";
+  if ([403, 423].includes(Number(value?.status)) || /403|suspend|blocked|banned|account.?locked/i.test(message)) return "restricted";
+  if (value?.status === 429 || /429|rate.?limit/i.test(message)) return "rate_limit";
+  return "feed";
+}
