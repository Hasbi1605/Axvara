+export function readonlyGoBizFetch(request: typeof fetch = fetch): typeof fetch {
+  return async (input, init) => {
+    const url = new URL(typeof input === "string" || input instanceof URL ? input : input.url);
+    const method = (init?.method || (input instanceof Request ? input.method : "GET")).toUpperCase();
+    const feed = url.origin === "https://api.gojekapi.com" && url.pathname === "/merchant-analytics/v2/merchants/transactions" && method === "GET";
+    const refresh = url.origin === "https://api.gobiz.co.id" && url.pathname === "/goid/token" && method === "POST";
+    if (!feed && !refresh) throw new Error("gobiz_request_not_allowed");
+    return request(input, { ...init, redirect: "manual" });
+  };
+}
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,345 @@
+// axvara-gopay-poller — Fase 1: poll mutasi GoBiz → forward match ke Pages.
+//
+// Loop:
+//   1. GET /api/webhook/gopay/pending (auth x-poller-secret) → nominal aktif
+//   2. Bila kosong: tidur, JANGAN hit GoBiz (hemat rate-limit)
+//   3. Bila ada: GET mutasi GoBiz langsung via p.transactions.list()
+//      (window = invoice tertua s/d sekarang, maks 2 jam ke belakang)
+//   4. Cocok: nominal persis + status settlement/capture + waktu dalam window
+//      invoice [issued_at - 60s, expires_at + 60s]
+//   5. POST /api/webhook/gopay {amount, order_code, event_id} (Pages verifikasi
+//      ulang + guard atomik — poller TIDAK memutuskan lunas, hanya melapor)
+//   6. 401 dari GoBiz → refresh token 1x → masih 401 → backoff 10 mnt + notif
+//
+// Aturan anti-ban (konsensus komunitas gobiz-payment, 2026-10-02):
+// read-only ke GoPay, interval 15 detik + jitter 0-3 detik, zero poll saat
+// idle (tidak hit GoBiz tanpa pending), session chmod 600, 1 IP + 1 device.
+
+import Fastify, { type RouteHandlerMethod } from "fastify";
+import { readFileSync, existsSync } from "node:fs";
+import { timingSafeEqual } from "node:crypto";
+import { GopayProvider } from "merchantid";
+import { merchantSessionPaths, routePendingInvoices, type PendingInvoice } from "./merchant-routing.js";
+import { forwardPayment } from "./pages-forward.js";
+import { loadFeedState, sessionDigest, writePrivateJson, type FeedState } from "./durable-store.js";
+import { readonlyGoBizFetch } from "./gobiz-transport.js";
+import { CLOCK_SKEW_MS, SETTLED, errorKind, feedInterval, invoiceTime, liveInvoices, matchSettlements, transactionTime, type GoBizTx } from "./poll-safety.js";
+
+const PAGES_BASE = (process.env.AXVARA_PAGES_BASE || "https://axvara.tech").replace(/\/+$/, "");
+const POLLER_SECRET = process.env.GOPAY_POLLER_SECRET || "";
+// Celah 1 (patch 2026-10-02): 9 detik fixed → 15 detik + jitter 0–3 detik.
+// Pola request fixed rapat = sidik jari bot paling mudah dibaca WAF/fraud
+// detection. Delay maks 18 detik tidak kerasa (QR berlaku 15 menit).
+function configuredInterval(name: string, fallback: number, minimum: number): number {
+  const value = Number(process.env[name] || fallback);
+  if (!Number.isFinite(value) || value < 0 || value > 3_600_000) throw new Error(`invalid_${name}`);
+  return Math.max(minimum, value);
+}
+const POLL_INTERVAL_MS = configuredInterval("POLL_INTERVAL_MS", 15_000, 15_000);
+const POLL_JITTER_MS = 3_000;
+// 2026-10-10 (insiden 1102 Workers Free): saat TIDAK ada invoice pending,
+// poller dulu tetap memanggil Pages `/pending` tiap ~16 dtk = ±5.100
+// request/hari (37% beban worker dari mesin). Idle kini 60 dtk; Pages
+// memanggil `POST /gopay/wake` saat QR GoPay terbit + saat pembeli klik
+// "Cek Status Sekarang"/"Periksa Pembayaran", sehingga deteksi tetap cepat.
+const IDLE_POLL_INTERVAL_MS = configuredInterval("IDLE_POLL_INTERVAL_MS", 60_000, POLL_INTERVAL_MS);
+// Jarak minimum antar poll walau dibangunkan berulang (spam klik / banyak QR)
+// — menjaga ritme anti-ban GoBiz; wake di dalam jarak ini dijadwalkan ke
+// batas jarak, bukan diabaikan.
+const WAKE_MIN_GAP_MS = configuredInterval("WAKE_MIN_GAP_MS", POLL_INTERVAL_MS, POLL_INTERVAL_MS);
+const SESSION_PATH = process.env.SESSION_PATH || "/opt/axvara/gopay/.session";
+const MERCHANT_ID = process.env.GOPAY_MERCHANT_ID || "G564039370";
+const MERCHANT_SESSIONS = merchantSessionPaths(MERCHANT_ID, SESSION_PATH,
+  process.env.GOPAY_SECONDARY_MERCHANT_ID, process.env.GOPAY_SECONDARY_SESSION_PATH);
+const TELEGRAM_BOT_TOKEN = process.env.TELEGRAM_BOT_TOKEN || "";
+const TELEGRAM_ADMIN_CHAT_ID = process.env.TELEGRAM_ADMIN_CHAT_ID || "";
+type Pending = PendingInvoice;
+
+const app = Fastify({ logger: true });
+const providers = new Map<string, GopayProvider>();
+let lastPollAt = 0;
+let lastLoopAt = 0; // awal iterasi loop terakhir (dasar jarak minimum wake)
+let lastResult: Record<string, unknown> = { status: "boot" };
+const feedStates = new Map<string, FeedState>();
+let lastSessionSavedAt = 0;
+// Celah 2 (patch 2026-10-02): backoff exponential untuk SEMUA error GoBiz
+// (bukan cuma 401). Retry cepat saat timeout/rate-limit = sinyal bot.
+const FEED_BACKOFF_BASE_MS = 30_000;
+const FEED_BACKOFF_MAX_MS = 5 * 60_000;
+const seenTx = new Map<string, number>(); // txId -> lapor pertama (dedup 2 jam)
+
+function loadProvider(merchantId: string): GopayProvider {
+  const existing = providers.get(merchantId);
+  if (existing) return existing;
+  const path = MERCHANT_SESSIONS.get(merchantId);
+  if (!path) throw new Error("merchant_session_not_configured");
+  const session = JSON.parse(readFileSync(path, "utf8"));
+  const provider = new GopayProvider({
+    merchantId, session,
+    fetch: readonlyGoBizFetch(), requestTimeoutMs: 15_000,
+    onTokenRefreshed: (next) => persistSession(merchantId, next),
+  });
+  providers.set(merchantId, provider);
+  return provider;
+}
+
+/** Refresh token berotasi; setiap akun menulis file sesinya sendiri secara atomik. */
+function persistSession(merchantId: string, session: unknown): void {
+  const path = MERCHANT_SESSIONS.get(merchantId);
+  if (!path) throw new Error("merchant_session_not_configured");
+  try {
+    writePrivateJson(path, session);
+    lastSessionSavedAt = Date.now();
+  } catch (e) {
+    const state = feedStates.get(merchantId);
+    if (state) state.blockedReason = "session_persist_failed";
+    app.log.error({ merchantId }, "session persist failed; stop this merchant");
+    throw Object.assign(new Error("session_persist_failed"), { code: "SESSION_PERSIST_FAILED" });
+  }
+}
+
+async function notifyAdmin(text: string): Promise<void> {
+  if (!TELEGRAM_BOT_TOKEN || !TELEGRAM_ADMIN_CHAT_ID) return;
+  await fetch(`https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ chat_id: TELEGRAM_ADMIN_CHAT_ID, text, parse_mode: "HTML" }),
+    signal: AbortSignal.timeout(10_000),
+  }).catch(() => undefined);
+}
+
+async function getPending(): Promise<Pending[]> {
+  const res = await fetch(`${PAGES_BASE}/api/webhook/gopay/pending`, {
+    redirect: "manual",
+    headers: { "x-poller-secret": POLLER_SECRET },
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!res.ok) throw new Error(`pending_http_${res.status}`);
+  const json = (await res.json()) as { pending?: Pending[] };
+  if (!Array.isArray(json.pending)) throw new Error("pending_invalid_response");
+  return liveInvoices(json.pending);
+}
+
+async function getMutations(merchantId: string, since: Date, until: Date): Promise<GoBizTx[]> {
+  const p = loadProvider(merchantId);
+  const raw = (await (p.transactions as unknown as {
+    list(id: string, q: unknown): Promise<unknown[]>;
+  }).list(merchantId, {
+    from: 0, size: 100, startTime: since, endTime: until,
+    statuses: ["settlement", "capture"], paymentTypes: ["qris", "gopay"],
+  })) as unknown as {
+    id: string; merchantId: string; currency: string; grossAmount: number; realGrossAmount?: number; status: string;
+    transactionTime: string; paymentType: string;
+  }[];
+  return (raw ?? []).map((t) => ({
+    id: String(t.id ?? ""),
+    merchantId: String(t.merchantId ?? ""), currency: String(t.currency ?? ""),
+    grossAmount: Number(t.grossAmount ?? 0),
+    realGrossAmount: t.realGrossAmount != null ? Number(t.realGrossAmount) : undefined,
+    status: String(t.status ?? ""),
+    transactionTime: String(t.transactionTime ?? ""),
+    paymentType: String(t.paymentType ?? ""),
+  })).filter((t) => t.id && t.grossAmount > 0);
+}
+
+async function forwardToPages(m: { amount: number; orderCode: string; txId: string; merchantId: string; paidAt: string; status: string }): Promise<boolean> {
+  const acknowledged = await forwardPayment(PAGES_BASE, POLLER_SECRET, m);
+  if (!acknowledged) app.log.warn("Pages payment ACK unavailable; retry on normal poll cadence");
+  return acknowledged;
+}
+
+async function pollMerchant(merchantId: string, pending: Pending[]): Promise<Record<string, unknown>> {
+  const path = MERCHANT_SESSIONS.get(merchantId)!;
+  const prior = feedStates.get(merchantId);
+  const state = loadFeedState(path);
+  if (prior?.blockedReason && prior.sessionDigest === state.sessionDigest) state.blockedReason = prior.blockedReason;
+  if (prior && prior.sessionDigest !== state.sessionDigest) providers.delete(merchantId);
+  feedStates.set(merchantId, state);
+  const save = () => { state.sessionDigest = sessionDigest(path); writePrivateJson(`${path}.poll-state`, state); };
+  if (state.blockedReason) return { status: state.blockedReason, pending: pending.length };
+  if (Date.now() < state.backoffUntil) return { status: "backoff", pending: pending.length };
+  if (Date.now() < state.nextPollAt) return { status: "paced", pending: pending.length };
+  state.nextPollAt = Date.now() + feedInterval(pending, POLL_INTERVAL_MS);
+  save();
+
+  const oldestIssued = pending.reduce((a, b) => (a.issued_at < b.issued_at ? a : b)).issued_at;
+  const sinceMs = invoiceTime(oldestIssued);
+  const since = new Date(Number.isFinite(sinceMs) ? Math.max(sinceMs - CLOCK_SKEW_MS, Date.now() - 2 * 3_600_000) : Date.now() - 2 * 3_600_000);
+
+  let mutations: GoBizTx[];
+  try {
+    mutations = await getMutations(merchantId, since, new Date());
+    state.feedErrorStreak = 0; // sukses → reset tangga backoff
+    state.backoffUntil = 0;
+    save();
+  } catch (e) {
+    const kind = state.blockedReason === "session_persist_failed" ? "persistence" : errorKind(e);
+    // Refresh token mati = WAJIB login OTP ulang (tidak bisa pulih sendiri):
+    // notif admin segera + backoff 10 mnt, bukan backoff feed biasa yang
+    // dulu diam saja tanpa kabar.
+    if (["session", "persistence", "restricted"].includes(kind)) {
+      state.blockedReason = kind === "session" ? "session_dead_login_required" : kind === "persistence" ? "session_persist_failed" : "account_restricted_manual_review";
+      if (Date.now() - state.last401NotifyAt > 3_600_000) {
+        state.last401NotifyAt = Date.now();
+        save();
+        await notifyAdmin(`🔴 <b>GoPay poller dijeda</b>\nMerchant ${merchantId}: ${state.blockedReason}. Periksa akun/sesi secara manual sebelum melanjutkan.`);
+      }
+      save();
+      return { status: state.blockedReason, pending: pending.length };
+    }
+    if (kind === "auth") {
+      // merchantid already refreshes and retries a 401 once. Another refresh
+      // here would repeat authentication requests after that attempt failed.
+        state.backoffUntil = Date.now() + 10 * 60_000;
+        if (Date.now() - state.last401NotifyAt > 3_600_000) {
+          state.last401NotifyAt = Date.now();
+          save();
+          await notifyAdmin(`🔴 <b>GoPay poller: session mati</b>\n401 berulang, backoff 10 menit. Login ulang OTP bila berlanjut.`);
+        }
+        save();
+        return { status: "auth_failed_backoff", pending: pending.length };
+    }
+    // Error non-auth (timeout, rate-limit 429, jaringan): backoff exponential
+    // 30s → 60s → 120s → … maks 5 menit, lalu coba lagi. JANGAN retry cepat.
+    state.feedErrorStreak++;
+    const waitMs = Math.min(FEED_BACKOFF_BASE_MS * 2 ** Math.min(state.feedErrorStreak - 1, 5), FEED_BACKOFF_MAX_MS);
+    state.backoffUntil = Date.now() + waitMs;
+    save();
+    app.log.warn({ error: kind, streak: state.feedErrorStreak, waitMs }, "feed error → backoff");
+    return { status: "feed_error_backoff", error: kind, pending: pending.length, waitMs };
+  }
+
+  const matches = matchSettlements(merchantId, pending, mutations).filter(({tx}) => {
+    const seen = seenTx.get(`${merchantId}:${tx.id}`);
+    return !seen || Date.now() - seen >= 2 * 3_600_000;
+  });
+  let forwarded = 0;
+  for (const { pen, tx } of matches) {
+    const ok = await forwardToPages({ amount: pen.payable_amount, orderCode: pen.order_code, txId: tx.id,
+      merchantId, paidAt: new Date(transactionTime(tx.transactionTime)).toISOString(), status: tx.status.trim().toLowerCase() });
+    if (ok) {
+      forwarded++;
+      seenTx.set(`${merchantId}:${tx.id}`, Date.now());
+    }
+  }
+  // Bersihkan dedup basi
+  for (const [id, at] of seenTx) if (Date.now() - at > 2 * 3_600_000) seenTx.delete(id);
+  return { status: "polled", pending: pending.length, mutations: mutations.length, matched: matches.length, forwarded };
+}
+
+async function pollOnce(): Promise<Record<string, unknown>> {
+  if (!POLLER_SECRET) return { status: "not_configured" };
+  const pending = await getPending();
+  lastPollAt = Date.now();
+  if (pending.length === 0) return { status: "idle", pending: 0 };
+  const { byMerchant, unroutable } = routePendingInvoices(pending, MERCHANT_ID, MERCHANT_SESSIONS);
+  const results: Record<string, unknown>[] = [];
+  for (const [merchantId, invoices] of byMerchant) {
+    try { results.push({ merchantId, ...await pollMerchant(merchantId, invoices) }); }
+    catch { results.push({ merchantId, status: "merchant_poll_error", pending: invoices.length }); }
+  }
+  return {
+    status: !unroutable && results.every(r => r.status === "polled") ? "polled" : "partial",
+    pending: pending.length, unroutable, merchants: results,
+    matched: results.reduce((n, r) => n + Number(r.matched || 0), 0),
+    forwarded: results.reduce((n, r) => n + Number(r.forwarded || 0), 0),
+  };
+}
+
+function validToken(raw: unknown): boolean {
+  if (!POLLER_SECRET || typeof raw !== "string") return false;
+  const a = Buffer.from(raw);
+  const b = Buffer.from(POLLER_SECRET);
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+app.get("/health", async () => ({
+  status: "ok",
+  provider: "axvara-gopay-poller",
+  phase: "fase-1",
+  configured: Boolean(POLLER_SECRET),
+  sessionExists: existsSync(SESSION_PATH),
+  merchantSessions: [...MERCHANT_SESSIONS].map(([merchantId, path]) => ({ merchantId, sessionExists: existsSync(path) })),
+  feedStates: [...feedStates].map(([merchantId, state]) => ({ merchantId, nextPollAt: state.nextPollAt, backoffUntil: state.backoffUntil, blockedReason: state.blockedReason })),
+  pollIntervalMs: POLL_INTERVAL_MS,
+  idlePollIntervalMs: IDLE_POLL_INTERVAL_MS,
+  wakeMinGapMs: WAKE_MIN_GAP_MS,
+  wakes: wakeCount,
+  lastSessionSavedAt,
+  lastPollAt, lastResult,
+}));
+
+// Tidur yang bisa dipotong `/wake`. Loop TETAP satu-satunya pemanggil
+// pollOnce → tidak pernah ada dua poll paralel ke GoBiz.
+let wakeSleeper: (() => void) | null = null;
+let wakePending = false;
+let wakeCount = 0;
+let wakeTimer: ReturnType<typeof setTimeout> | undefined;
+
+function interruptibleSleep(ms: number): Promise<void> {
+  return new Promise((resolve) => {
+    const timer = setTimeout(done, ms);
+    function done() {
+      clearTimeout(timer);
+      if (wakeSleeper === done) wakeSleeper = null;
+      resolve();
+    }
+    wakeSleeper = done;
+  });
+}
+
+/** Path publik via Caddy: `POST https://wr-proxy.axvara.tech/gopay/wake`. */
+const requestWake: RouteHandlerMethod = async (req, reply) => {
+  if (!validToken(req.headers["x-poller-secret"])) return reply.status(401).send({ status: false });
+  wakeCount++;
+  wakePending = true;
+  // Hormati jarak minimum: bangunkan sekarang bila poll terakhir sudah cukup
+  // lama, selain itu loop akan bangun tepat di batas jarak (lihat loop()).
+  const nextFeed = lastResult.status === "idle" || !feedStates.size ? 0 : Math.min(...[...feedStates.values()].map(state => state.nextPollAt));
+  const eta = Math.max(0, lastLoopAt + WAKE_MIN_GAP_MS - Date.now(), nextFeed - Date.now());
+  if (!eta) wakeSleeper?.();
+  else if (!wakeTimer) wakeTimer = setTimeout(() => { wakeTimer = undefined; wakeSleeper?.(); }, eta).unref();
+  return { status: true, queued: true, eta_ms: eta };
+};
+app.post("/wake", requestWake);
+// Legacy manual trigger shares the paced loop; it must not race session refresh.
+app.post("/tick", requestWake);
+
+app.get("/session/status", async (req, reply) => {
+  if (!validToken(req.headers["x-poller-secret"])) return reply.status(401).send({ status: false });
+  return { status: true, sessionExists: existsSync(SESSION_PATH) };
+});
+
+async function loop(): Promise<void> {
+  for (;;) {
+    lastLoopAt = Date.now();
+    wakePending = false;
+    try {
+      lastResult = await pollOnce();
+    } catch (e) {
+      lastResult = { status: "loop_error", error: String((e as Error)?.message ?? e).slice(0, 200) };
+      app.log.error(lastResult, "poll loop error");
+    }
+    // Jitter 0–3 detik: jeda tidak pernah fixed → tidak seperti cron bot.
+    // Idle (tanpa invoice pending) = 60 dtk; ada pending / error = 15 dtk.
+    const base = lastResult.status === "idle" ? IDLE_POLL_INTERVAL_MS : POLL_INTERVAL_MS;
+    let waitMs = base + Math.floor(Math.random() * (POLL_JITTER_MS + 1));
+    // Wake yang datang SELAMA poll berjalan → poll lagi di batas jarak minimum.
+    if (wakePending) waitMs = Math.max(0, WAKE_MIN_GAP_MS - (Date.now() - lastLoopAt));
+    await interruptibleSleep(waitMs);
+  }
+}
+
+const PORT = Number(process.env.PORT || 3002);
+app.listen({ port: PORT, host: "127.0.0.1" })
+  .then(() => {
+    app.log.info({ port: PORT }, "axvara-gopay-poller Fase 1 listening");
+    if (POLLER_SECRET && [...MERCHANT_SESSIONS.values()].some(path => existsSync(path))) void loop();
+    else app.log.warn("poller idle: secret/session belum lengkap (loop tidak jalan)");
+  })
+  .catch((err) => {
+    app.log.fatal({ err }, "fatal");
+    process.exit(1);
+  });
+
+export { SETTLED };
diff --git a/src/login.ts b/src/login.ts
new file mode 100644
--- /dev/null
+++ b/src/login.ts
@@ -0,0 +1,54 @@
+// Login OTP GoBiz dua langkah (non-interaktif, aman lewat SSH) — 2026-10-10.
+//   node dist/login.js request <nomor tanpa 0/62, mis. 81234567890>
+//   node dist/login.js verify <kode OTP>
+// deviceId diambil dari sesi lama agar GoBiz tidak melihat perangkat baru
+// (anti-ban: 1 IP + 1 device). Hasil ditulis atomik ke SESSION_PATH chmod 600,
+// lalu `sudo systemctl restart gopay-poller`.
+import { readFileSync, writeFileSync, existsSync, renameSync, unlinkSync } from "node:fs";
+import { GopayProvider } from "merchantid";
+import { writePrivateJson } from "./durable-store.js";
+
+const SESSION_PATH = process.env.SESSION_PATH || "/opt/axvara/gopay/.session";
+const PENDING_PATH = `${SESSION_PATH}.otp`;
+const MERCHANT_ID = process.env.GOPAY_MERCHANT_ID || "G564039370";
+
+function oldDeviceId(): string | undefined {
+  try { return JSON.parse(readFileSync(SESSION_PATH, "utf8")).deviceId; } catch { return undefined; }
+}
+
+function writeAtomic(path: string, data: unknown): void {
+  writePrivateJson(path, data);
+}
+
+async function main(): Promise<void> {
+  const [step, arg] = process.argv.slice(2);
+  if (step === "request" && arg) {
+    if (existsSync(PENDING_PATH)) {
+      const prior = JSON.parse(readFileSync(PENDING_PATH, "utf8"));
+      if (Date.now() - Number(prior.at) < 120_000) throw new Error("otp_request_cooldown_120s");
+    }
+    const phone = arg.replace(/\D/g, "").replace(/^(62|0)/, "");
+    const deviceId = oldDeviceId();
+    const gp = new GopayProvider({ merchantId: MERCHANT_ID, deviceId });
+    const res = await gp.requestOtp(phone, "62");
+    if (!res.otpToken) throw new Error("GoPay tidak mengembalikan otpToken");
+    writeAtomic(PENDING_PATH, { phone, otpToken: res.otpToken, deviceId: deviceId ?? gp.exportSession().deviceId, at: Date.now() });
+    console.log("OTP terkirim. Lanjut: node dist/login.js verify <kode>");
+    return;
+  }
+  if (step === "verify" && arg) {
+    if (!existsSync(PENDING_PATH)) throw new Error("Belum ada request OTP");
+    const p = JSON.parse(readFileSync(PENDING_PATH, "utf8"));
+    if (!Number.isFinite(p.at) || Date.now() - p.at > 5 * 60_000) throw new Error("otp_challenge_expired");
+    const gp = new GopayProvider({ merchantId: MERCHANT_ID, deviceId: p.deviceId });
+    await gp.verifyOtp({ otp: arg.trim(), otpToken: p.otpToken, phoneNumber: p.phone, countryCode: "62" });
+    writeAtomic(SESSION_PATH, gp.exportSession());
+    unlinkSync(PENDING_PATH);
+    console.log("Login sukses, sesi tersimpan. Jalankan: sudo systemctl restart gopay-poller");
+    return;
+  }
+  console.log("Pakai: login.js request <nomor> | login.js verify <otp>");
+  process.exit(2);
+}
+
+main().catch((e) => { console.error("GAGAL:", (e as Error).message); process.exit(1); });
