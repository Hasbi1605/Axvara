+  env:{...process.env,PORT:String(port),AXVARA_PAGES_BASE:`http://127.0.0.1:${pages.address().port}`,GOPAY_POLLER_SECRET:'test-secret',GOPAY_MERCHANT_ID:oldId,SESSION_PATH:old,GOPAY_SECONDARY_MERCHANT_ID:newId,GOPAY_SECONDARY_SESSION_PATH:next,TELEGRAM_BOT_TOKEN:'',TELEGRAM_ADMIN_CHAT_ID:'',POLLER_TEST_FEEDS:JSON.stringify(feeds),POLLER_TEST_CALLS:calls},stdio:['ignore','pipe','pipe'],
+ });
+ let output='';child.stdout.on('data',part=>output+=part);child.stderr.on('data',part=>output+=part);
+ try {
+  let health;
+  for(let i=0;i<120;i++){
+   try{health=await(await fetch(`http://127.0.0.1:${port}/health`)).json();if(health.lastResult.status!=='boot')break;}catch{}
+   if(child.exitCode!==null)throw new Error('poller exited: '+output);
+   await pause(25);
+  }
+  assert.ok(health?.lastResult.status!=='boot','poller did not complete its first iteration: '+output);
+  await verify({health,received,old,next,calls,port});
+ } finally {child.kill('SIGTERM');await new Promise(resolve=>child.once('exit',resolve));await new Promise(resolve=>pages.close(resolve));await rm(dir,{recursive:true,force:true});}
+}
