new file mode 100644
--- /dev/null
+++ b/src/durable-store.ts
@@ -0,0 +1,43 @@
+import { closeSync, existsSync, fsyncSync, openSync, readFileSync, renameSync, unlinkSync, writeFileSync } from "node:fs";
+import { dirname } from "node:path";
+import { createHash, randomUUID } from "node:crypto";
+
+export function writePrivateJson(path: string, value: unknown): void {
+  const temporary = `${path}.${randomUUID()}.tmp`;
+  let file: number | undefined;
+  try {
+    file = openSync(temporary, "wx", 0o600);
+    writeFileSync(file, JSON.stringify(value));
+    fsyncSync(file);
+    closeSync(file); file = undefined;
+    renameSync(temporary, path);
+    const directory = openSync(dirname(path), "r");
+    try { fsyncSync(directory); } finally { closeSync(directory); }
+  } finally {
+    if (file !== undefined) closeSync(file);
+    if (existsSync(temporary)) unlinkSync(temporary);
+  }
+}
+
+export function sessionDigest(path: string): string {
+  return createHash("sha256").update(readFileSync(path)).digest("hex");
+}
+
+export type FeedState = {
+  sessionDigest: string; nextPollAt: number; backoffUntil: number;
+  feedErrorStreak: number; last401NotifyAt: number; blockedReason: string | null;
+};
+
+export function loadFeedState(sessionPath: string): FeedState {
+  const digest = sessionDigest(sessionPath);
+  const empty: FeedState = { sessionDigest: digest, nextPollAt: 0, backoffUntil: 0, feedErrorStreak: 0, last401NotifyAt: 0, blockedReason: null };
+  const path = `${sessionPath}.poll-state`;
+  if (!existsSync(path)) return empty;
+  const saved = JSON.parse(readFileSync(path, "utf8")) as FeedState;
+  if (!saved || typeof saved.sessionDigest !== "string"
+    || ![saved.nextPollAt, saved.backoffUntil, saved.feedErrorStreak, saved.last401NotifyAt].every(n => Number.isFinite(n) && n >= 0)
+    || !(saved.blockedReason === null || typeof saved.blockedReason === "string")) throw new Error("invalid_feed_state");
+  // A manual login replaces the session. A service restart alone cannot clear
+  // a restriction, authentication failure, or the next permitted feed request.
+  return saved.sessionDigest === digest ? saved : { ...empty, nextPollAt: saved.nextPollAt };
+}
