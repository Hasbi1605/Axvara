# Admin — Edge-safe SHA-256 (tanpa bcrypt di edge)
# JANGAN commit hash prod di sini — isi placeholder, set yang real di Cloudflare Pages Variables
ADMIN_EMAIL=admin@axvara.tech
ADMIN_PASSWORD_SHA256=__ISI_DI_CLOUDFLARE_PAGES_VARIABLES__ # sha256(password) — contoh: echo -n "pass" | shasum -a 256
ADMIN_JWT_SECRET=__ISI_DI_CLOUDFLARE_PAGES_VARIABLES__ # secret acak stabil; gunakan .env.local saat development
CRON_SECRET=__ISI_DI_CLOUDFLARE_PAGES_VARIABLES__ # harus sama dengan AXVARA_CRON_SECRET di MCP Worker
SITE_URL=https://axvara.tech
# Legacy (opsional, tidak dipakai di edge): ADMIN_PASSWORD_HASH=$2b$10$... # bcrypt
# Cloudflare
# WRANGLER_D1_ID=...
# WRANGLER_R2_BUCKET=axvara-assets
# WA Gateway — Baileys service terpisah di Heroku

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=__SET_IN_CLOUDFLARE__
TELEGRAM_WEBHOOK_SECRET=__SET_IN_CLOUDFLARE__
# ID numerik user/grup; grup privat berbentuk -100... (jalankan /chatid di grup)
TELEGRAM_ADMIN_CHAT_ID=__SET_IN_CLOUDFLARE__
TELEGRAM_BOT_ENABLED=false

# --- DANA Business Dynamic QRIS ---
# Raw merchant QRIS is a server-only secret; never expose it to browser/source control.
DANA_STATIC_QRIS=__SET_IN_CLOUDFLARE_PAGES_SECRETS__
DANA_WEBHOOK_SECRET=__SET_IN_CLOUDFLARE_PAGES_SECRETS__
DANA_QRIS_ENABLED=false
# Android QRIS Hook target: https://axvara.tech/api/webhook/dana

# --- Fulfillment ---
FULFILLMENT_ENCRYPTION_KEY=__BASE64_32_BYTES_SET_IN_CLOUDFLARE__
AUTO_FULFILLMENT_ENABLED=false

# --- Product Variants (Phase 1-2) ---
PRODUCT_VARIANTS_READ=false
PRODUCT_VARIANTS_WRITE=false

# --- Telegram Variant Flow (Phase 4) ---
TELEGRAM_VARIANT_FLOW=false

# --- Warung Rebahan H2H Integration ---
# Seluruh integrasi WR dikendalikan master switch ini. Jika false, semua
# fitur WR (sync, auto-order, webhook) nonaktif dan Axvara jalan murni lokal.
WARUNG_REBAHAN_ENABLED=false
# API key dari dashboard WR. Server-only: tidak pernah di-log atau di-expose ke client.
WARUNG_REBAHAN_API_KEY=
# Secret validasi webhook (WR memakai API key yang sama sebagai HMAC secret).
WARUNG_REBAHAN_WEBHOOK_SECRET=
WARUNG_REBAHAN_BASE_URL=https://warungrebahan.com/api/v1
WARUNG_REBAHAN_DEFAULT_MARKUP_PERCENT=50
WARUNG_REBAHAN_DEFAULT_MARKUP_FIXED=0
WARUNG_REBAHAN_SALDO_ALERT_THRESHOLD=50000
WARUNG_REBAHAN_AUTO_ORDER_ENABLED=false
WARUNG_REBAHAN_SYNC_ENABLED=true
WARUNG_REBAHAN_DEFAULT_CATEGORY_ID=2
WARUNG_REBAHAN_SANDBOX=false

# --- WhatsApp Bot (Phase 5-6) ---
WHATSAPP_ENABLED=false
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_BOT_NUMBER=
WHATSAPP_GROUP_ALLOWLIST=
# Contoh: https://axvara-wa-gateway-xxxx.herokuapp.com
WHATSAPP_GATEWAY_URL=
WHATSAPP_GROUP_DISCOVERY=false
WHATSAPP_GROUP_PAYMENT=false
WHATSAPP_PROOF_INTAKE=false
WHATSAPP_REQUIRE_PROOF_BEFORE_FULFILLMENT=false
WHATSAPP_FULFILLMENT=false
