# Admin — Edge-safe SHA-256 (tanpa bcrypt di edge)
# JANGAN commit hash prod di sini — isi placeholder, set yang real di Cloudflare Pages Variables
ADMIN_EMAIL=admin@axvara.tech
ADMIN_PASSWORD_SHA256=__ISI_DI_CLOUDFLARE_PAGES_VARIABLES__ # sha256(password) — contoh: echo -n "pass" | shasum -a 256
ADMIN_JWT_SECRET=__ISI_DI_CLOUDFLARE_PAGES_VARIABLES__ # secret acak stabil; gunakan .env.local saat development
CRON_SECRET=__ISI_DI_CLOUDFLARE_PAGES_VARIABLES__ # harus sama dengan AXVARA_CRON_SECRET di MCP Worker
SITE_URL=https://axvara.tech
# Legacy (opsional, tidak dipakai di edge): ADMIN_PASSWORD_HASH=$2b$10$... # bcrypt
# Cloudflare
# WRANGLER_D1_ID=...
# WRANGLER_R2_BUCKET=axvara-assets
# WA Gateway — Baileys service terpisah di Heroku

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=__SET_IN_CLOUDFLARE__
TELEGRAM_WEBHOOK_SECRET=__SET_IN_CLOUDFLARE__
# ID numerik user/grup; grup privat berbentuk -100... (jalankan /chatid di grup)
TELEGRAM_ADMIN_CHAT_ID=__SET_IN_CLOUDFLARE__
TELEGRAM_BOT_ENABLED=false
# Kirim dua digest promo ke TELEGRAM_ADMIN_CHAT_ID pada 09.00 dan 17.00 WIB.
TELEGRAM_PROMO_DIGEST_ENABLED=false

# --- DANA Business Dynamic QRIS ---
# Raw merchant QRIS is a server-only secret; never expose it to browser/source control.
DANA_STATIC_QRIS=__SET_IN_CLOUDFLARE_PAGES_SECRETS__
DANA_WEBHOOK_SECRET=__SET_IN_CLOUDFLARE_PAGES_SECRETS__
DANA_QRIS_ENABLED=false
# Android QRIS Hook target: https://axvara.tech/api/webhook/dana

# --- GoPay Merchant QRIS (Fase 1, default mati — DANA tetap rail aktif) ---
# QRIS statis dari portal GoBiz (server-only secret, pola sama dengan DANA).
# Poller server (VPS, BUKAN Pages — Pages Edge tanpa fs untuk session) login
# GoBiz 1x via OTP, refresh token otomatis, poll mutasi 8–10 detik lalu POST
# ke https://axvara.tech/api/webhook/gopay dengan header x-poller-secret.
GOPAY_STATIC_QRIS=__SET_IN_CLOUDFLARE_PAGES_SECRETS__
GOPAY_POLLER_SECRET=__SET_IN_CLOUDFLARE_PAGES_SECRETS__
GOPAY_QRIS_ENABLED=false
# Rail order BARU: dana (default, perilaku hari ini) | gopay. Rollback = 1 env.
QRIS_ACTIVE_PROVIDER=dana

# --- Fulfillment ---
FULFILLMENT_ENCRYPTION_KEY=__BASE64_32_BYTES_SET_IN_CLOUDFLARE__
AUTO_FULFILLMENT_ENABLED=false

# --- Product Variants (Phase 1-2) ---
PRODUCT_VARIANTS_READ=false
PRODUCT_VARIANTS_WRITE=false

# --- Telegram Variant Flow (Phase 4) ---
TELEGRAM_VARIANT_FLOW=false

# --- Warung Rebahan H2H Integration ---
# Seluruh integrasi WR dikendalikan master switch ini. Jika false, semua
# fitur WR (sync, auto-order, webhook) nonaktif dan Axvara jalan murni lokal.
WARUNG_REBAHAN_ENABLED=false
# API key dari dashboard WR. Server-only: tidak pernah di-log atau di-expose ke client.
# MODE PROXY (Opsi A, produksi): key asli HANYA di VPS (WR_API_KEY server);
# Pages cukup isi 2 var proxy di bawah, WARUNG_REBAHAN_API_KEY boleh kosong.
WARUNG_REBAHAN_API_KEY=
# Proxy VPS AWS (lawan IP whitelist WR): seluruh panggilan WR lewat VPS
# yang IP-nya di-whitelist di dashboard WR. Kosongkan = mode langsung (dev lokal).
WARUNG_REBAHAN_PROXY_URL=https://wr-proxy.axvara.tech
# Token auth Pages→proxy (sama dengan WR_PROXY_TOKEN di server VPS).
WARUNG_REBAHAN_PROXY_TOKEN=
# Secret validasi webhook (WR memakai API key yang sama sebagai HMAC secret).
WARUNG_REBAHAN_WEBHOOK_SECRET=
# Bot email WR→buyer (fase 2): forwarder Apps Script (docs/WR-EMAIL-FORWARDER.gs.js,
# label Gmail WR-INGEST) POST ke /api/webhook/wr-email dengan secret ini.
# Server-only: JANGAN commit nilai asli, set di Pages Secrets (secret_text).
WR_EMAIL_WEBHOOK_SECRET=
# Pengirim email branding Axvara via Resend (https://resend.com).
# FORWARD_FROM_EMAIL = alamat domain sendiri yg sudah verifikasi DNS
# (mis. noreply@axvara.id). Tanpa keduanya bot menahan kirim (status held).
RESEND_API_KEY=
FORWARD_FROM_EMAIL=
WARUNG_REBAHAN_BASE_URL=https://warungrebahan.com/api/v1
WARUNG_REBAHAN_DEFAULT_MARKUP_PERCENT=50
WARUNG_REBAHAN_DEFAULT_MARKUP_FIXED=0
WARUNG_REBAHAN_SALDO_ALERT_THRESHOLD=250000
WARUNG_REBAHAN_AUTO_ORDER_ENABLED=false
# Auto-order untuk varian kelas ANTREAN (made_by_order / belum dikunci).
# Default aktif mengikuti AUTO_ORDER_ENABLED. Set 'false' sebagai saklar
# mundur tanpa deploy bila respons upstream untuk kelas ini bermasalah.
WARUNG_REBAHAN_AUTO_ORDER_MBO=true
WARUNG_REBAHAN_SYNC_ENABLED=true
WARUNG_REBAHAN_DEFAULT_CATEGORY_ID=2
WARUNG_REBAHAN_SANDBOX=false

# --- Sekalipay Reseller API (supplier kedua paralel WR, 2026-09-30) ---
# Seluruh integrasi SK dikendalikan master switch ini. Jika false, semua
# fitur SK (sync, auto-order, webhook) nonaktif dan Axvara jalan seperti
# sebelum SK ada (WR + non-WR tidak tersentuh).
SEKALIPAY_ENABLED=false
# API key dari dashboard SK. Server-only: tidak pernah di-log/expose ke client.
# MODE PROXY (produksi): key asli HANYA di Heroku (SK_API_KEY dyno, app
# axvara-wr-proxy akun #2); Pages cukup isi 2 var proxy di bawah,
# SEKALIPAY_API_KEY boleh kosong (dipakai dev lokal langsung saja).
SEKALIPAY_API_KEY=
# Proxy VPS AWS (egress statis EIP yang SAMA dengan WR — tanpa add-on
# baru): seluruh panggilan SK lewat VPS yang IP-nya di-whitelist di dashboard
# SK (maks 3 IP). Kosongkan = mode langsung (dev lokal).
SEKALIPAY_PROXY_URL=https://wr-proxy.axvara.tech
# Token auth Pages→proxy (sama dengan WR_PROXY_TOKEN di server VPS).
SEKALIPAY_PROXY_TOKEN=
# Secret validasi webhook SK (tombol Generate di dashboard SK → Callback URL
# https://axvara.tech/api/webhook/sekalipay). Server-only, secret_text.
SEKALIPAY_WEBHOOK_SECRET=
SEKALIPAY_BASE_URL=https://sekalipay.com/api
SEKALIPAY_DEFAULT_MARKUP_PERCENT=50
SEKALIPAY_DEFAULT_MARKUP_FIXED=0
SEKALIPAY_SALDO_ALERT_THRESHOLD=250000
SEKALIPAY_AUTO_ORDER_ENABLED=false
SEKALIPAY_SYNC_ENABLED=true
SEKALIPAY_DEFAULT_CATEGORY_ID=1
SEKALIPAY_SANDBOX=false

# --- WhatsApp Bot (Phase 5-6) ---
WHATSAPP_ENABLED=false
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_BOT_NUMBER=
WHATSAPP_GROUP_ALLOWLIST=
# Contoh: https://axvara-wa-gateway-xxxx.herokuapp.com
WHATSAPP_GATEWAY_URL=
WHATSAPP_GROUP_DISCOVERY=false
WHATSAPP_GROUP_PAYMENT=false
WHATSAPP_PROOF_INTAKE=false
WHATSAPP_REQUIRE_PROOF_BEFORE_FULFILLMENT=false
WHATSAPP_FULFILLMENT=false
# Kill-switch DM kredensial otomatis ke buyer (19 Sep 2026, default MATI
# pasca-restriction nomor BOT — memulai chat baru = yang dibatasi WA).
# Grup tetap hidup penuh; kredensial jalan via email + panel web + manual HP.
# Kode + mekanisme DM UTUH di bawah gate ini. Nyalakan lagi: "true" + deploy
# (pastikan nomor sehat + lewati warming 2-3 hari; pantau outbox 1 jam pertama).
WHATSAPP_CREDENTIAL_DM_ENABLED=false
# Pacing manusiawi antar kirim outbox WA dalam satu run cron (ms, default 6000).
# Jeda aktual = nilai ini + jitter acak 0-3000ms. Nilai 0 = tanpa jeda sama
# sekali (termasuk jitter) — dipakai test. Jangan nol-kan di produksi.
WHATSAPP_OUTBOX_PACE_MS=6000
